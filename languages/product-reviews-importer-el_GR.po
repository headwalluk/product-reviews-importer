msgstr "Η περίοδος σύνδεσης για τη μεταφόρτωση έληξε. Παρακαλώ μεταφορτώστε ξανά το αρχείο."

#: includes/class-admin-hooks.php:307
msgid "CSV file not found."
msgstr "Δεν βρέθηκε το αρχείο CSV."

