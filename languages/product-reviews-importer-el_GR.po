#, php-format
msgid "Missing required columns: %s"
msgstr "Λείπουν υποχρεωτικές στήλες: %s"

#: includes/class-csv-importer.php:321
msgid "CSV file contains no data rows."
msgstr "Το αρχείο CSV δεν περιέχει σειρές δεδομένων."

#: includes/class-plugin.php:110
msgid "Import Reviews"
msgstr "Εισαγωγή κριτικών"

#: includes/class-review-exporter.php:37
msgid "You do not have sufficient permissions."
msgstr "Δεν διαθέτετε τα απαραίτητα δικαιώματα."