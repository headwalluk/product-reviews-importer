#. Plugin Name of the plugin
#: product-reviews-importer.php
#: includes/class-plugin.php:109
msgid "Product Reviews Importer"
msgstr "Importeur van productrecensies"

#. Plugin URI of the plugin
#: product-reviews-importer.php
msgid "https://headwall-hosting.com/plugins/product-reviews-importer-for-woocommerce/"
msgstr "https://headwall-hosting.com/plugins/product-reviews-importer-for-woocommerce/"

#. Description of the plugin
#: product-reviews-importer.php
msgid "Import and export WooCommerce product reviews. CSV import with batch processing, and export for Walmart review syndication."
msgstr "WooCommerce-productrecensies importeren en exporteren. CSV-import met batchverwerking en export voor het delen van recensies op Walmart."

#. Author of the plugin
#: product-reviews-importer.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: product-reviews-importer.php
msgid "https://headwall-hosting.com/"
msgstr "https://headwall-hosting.com/"

#: admin-templates/main-page.php:27
msgid "Secondary menu"
msgstr "Submenu"

#: admin-templates/main-page.php:31
msgid "Import"
msgstr "Importeren"

#: admin-templates/main-page.php:35
msgid "Export"
msgstr "Exporteren"

#: admin-templates/main-page.php:39
#: includes/class-plugin.php:187
msgid "Settings"
msgstr "Instellingen"

#: admin-templates/main-page.php:43
msgid "Help"
msgstr "Hulp"

#: admin-templates/tab-export.php:23
msgid "Walmart Review Syndication"
msgstr "Walmart-recensies delen"

#: admin-templates/tab-export.php:28
msgid "Export all approved product reviews in the format required for Walmart review syndication. The exported CSV follows Walmart's specification with the following columns:"
msgstr "Exporteer alle goedgekeurde productrecensies in het formaat dat vereist is voor de verspreiding van recensies door Walmart. Het geëxporteerde CSV-bestand voldoet aan de specificaties van Walmart en bevat de volgende kolommen:"

#: admin-templates/tab-export.php:34
msgid "Walmart Item ID"
msgstr "Walmart-artikelcode"

#: admin-templates/tab-export.php:35
msgid "Left blank — fill in with your Walmart Item IDs after export."
msgstr "Leeg gelaten — vul hier na het exporteren uw Walmart-artikel-ID’s in."

#: admin-templates/tab-export.php:39
msgid "SKU"
msgstr "SKU"

#: admin-templates/tab-export.php:40
msgid "Your WooCommerce product SKU."
msgstr "De SKU van uw WooCommerce-product."

#: admin-templates/tab-export.php:44
msgid "Review Title"
msgstr "Titel van de recensie"

#: admin-templates/tab-export.php:45
msgid "Left blank — WooCommerce reviews do not have titles."
msgstr "Leeg gelaten — WooCommerce-recensies hebben geen titel."

#: admin-templates/tab-export.php:49
msgid "Review Body"
msgstr "Beoordelingsinstantie"

#: admin-templates/tab-export.php:50
msgid "The full review text."
msgstr "De volledige recensie."

#: admin-templates/tab-export.php:54
msgid "Review Rating"
msgstr "Beoordeling"

#: admin-templates/tab-export.php:55
msgid "Star rating (1–5)."
msgstr "Sterrenbeoordeling (1–5)."

#: admin-templates/tab-export.php:59
msgid "Review Created Date"
msgstr "Datum van aanmaak van de recensie"

#: admin-templates/tab-export.php:60
msgid "Formatted as MM/DD/YYYY per Walmart requirements."
msgstr "Opgemaakt in de notatie MM/DD/JJJJ, conform de voorschriften van Walmart."

#: admin-templates/tab-export.php:64
msgid "Review User Name"
msgstr "Beoordeling Gebruikersnaam"

#: admin-templates/tab-export.php:65
msgid "The reviewer's name as it appears on your site."
msgstr "De naam van de recensent zoals die op uw website staat vermeld."

#: admin-templates/tab-export.php:69
msgid "URL link"
msgstr "URL-link"

#: admin-templates/tab-export.php:70
msgid "Link to the product page on your website."
msgstr "Link naar de productpagina op uw website."

#: admin-templates/tab-export.php:74
msgid "Incentivized Review"
msgstr "Beoordeling op basis van een beloning"

#: admin-templates/tab-export.php:75
msgid "Defaults to \"No\" — update manually if applicable."
msgstr "Standaard ingesteld op \\\"Nee\\\" — pas dit indien nodig handmatig aan."

#. translators: %d: number of approved reviews
#: admin-templates/tab-export.php:84
#, php-format
msgid "There are currently %d approved reviews to export."
msgstr "Er zijn momenteel %d goedgekeurde beoordelingen om te exporteren."

#: admin-templates/tab-export.php:98
msgid "Export Walmart CSV"
msgstr "Exporteer naar Walmart CSV"

#: admin-templates/tab-export.php:103
msgid "No approved reviews to export. Import some reviews first, or check that existing reviews are approved."
msgstr "Er zijn geen goedgekeurde beoordelingen om te exporteren. Importeer eerst enkele beoordelingen of controleer of de bestaande beoordelingen zijn goedgekeurd."

#: admin-templates/tab-help.php:19
msgid "How to Import Product Reviews"
msgstr "Productrecensies importeren"

#: admin-templates/tab-help.php:25
msgid "CSV File Format"
msgstr "CSV-bestandsformaat"

#: admin-templates/tab-help.php:29
msgid "Your CSV file must include the following columns (all values should be quoted):"
msgstr "Uw CSV-bestand moet de volgende kolommen bevatten (alle waarden moeten tussen aanhalingstekens staan):"

#: admin-templates/tab-help.php:50
msgid "Sample CSV"
msgstr "Voorbeeld-CSV"

#: admin-templates/tab-help.php:60
msgid "Important Notes"
msgstr "Belangrijke opmerkingen"

#: admin-templates/tab-help.php:65
msgid "Reviews are matched to products using the SKU field"
msgstr "Recensies worden aan producten gekoppeld aan de hand van het SKU-veld"

#: admin-templates/tab-help.php:69
msgid "If a product variation SKU is provided, the review will be attached to the parent product"
msgstr "Als er een SKU voor een productvariant wordt opgegeven, wordt de recensie gekoppeld aan het hoofdproduct"

#: admin-templates/tab-help.php:73
msgid "Duplicate reviews (same email + product) will update the existing review"
msgstr "Bij dubbele beoordelingen (zelfde e-mailadres + product) wordt de bestaande beoordeling bijgewerkt"

#: admin-templates/tab-help.php:77
msgid "Review text supports line breaks and basic formatting"
msgstr "De tekst in de recensie ondersteunt regeleinden en eenvoudige opmaak"

#: admin-templates/tab-help.php:81
msgid "Invalid rows will be skipped and reported in the import results"
msgstr "Ongeldige rijen worden overgeslagen en vermeld in de importresultaten"

#: admin-templates/tab-help.php:88
msgid "Troubleshooting"
msgstr "Problemen oplossen"

#: admin-templates/tab-help.php:92
msgid "Product not found errors:"
msgstr "Fouten bij het zoeken naar producten:"

#: admin-templates/tab-help.php:93
msgid "Verify that the SKU exactly matches a product in your store. SKUs are case-sensitive."
msgstr "Controleer of de SKU exact overeenkomt met een product in uw winkel. Bij SKU’s wordt onderscheid gemaakt tussen hoofdletters en kleine letters."

#: admin-templates/tab-help.php:97
msgid "Invalid email errors:"
msgstr "Fouten met ongeldige e-mailadressen:"

#: admin-templates/tab-help.php:98
msgid "Ensure email addresses are in valid format (e.g., user@example.com)."
msgstr "Zorg ervoor dat e-mailadressen een geldige indeling hebben (bijv. user@example.com)."

#: admin-templates/tab-help.php:102
msgid "Invalid star rating errors:"
msgstr "Fouten met ongeldige sterrenbeoordelingen:"

#: admin-templates/tab-help.php:103
msgid "Star ratings must be whole numbers from 1 to 5."
msgstr "Sterbeoordelingen moeten hele getallen zijn tussen 1 en 5."

#: admin-templates/tab-help.php:107
msgid "Review text too short:"
msgstr "De recensietekst is te kort:"

#: admin-templates/tab-help.php:108
msgid "Check the minimum review length setting in the Settings tab."
msgstr "Controleer de instelling voor de minimale lengte van een recensie op het tabblad Instellingen."

#: admin-templates/tab-help.php:114
msgid "Developer Hooks"
msgstr "Ontwikkelaars-hooks"

#: admin-templates/tab-help.php:118
msgid "The following filter hooks are available for developers to extend or customize plugin functionality:"
msgstr "De volgende filterhooks zijn beschikbaar voor ontwikkelaars om de functionaliteit van plug-ins uit te breiden of aan te passen:"

#: admin-templates/tab-help.php:122
msgid "product_reviews_importer_csv_field_definitions"
msgstr "productrecensies-importer-csv-velddefinities"

#: admin-templates/tab-help.php:123
msgid "Customize CSV field definitions, add custom fields, or modify existing field behavior."
msgstr "Pas CSV-velddefinities aan, voeg aangepaste velden toe of wijzig het gedrag van bestaande velden."

#: admin-templates/tab-import.php:20
msgid "Import Reviews from CSV"
msgstr "Recensies importeren vanuit CSV"

#: admin-templates/tab-import.php:27
msgid "Step 1: Upload CSV File"
msgstr "Stap 1: CSV-bestand uploaden"

#: admin-templates/tab-import.php:44
msgid "Select a CSV file containing product reviews. The file must include the following columns:"
msgstr "Selecteer een CSV-bestand met productrecensies. Het bestand moet de volgende kolommen bevatten:"

#: admin-templates/tab-import.php:52
msgid "Sample CSV Format"
msgstr "Voorbeeld van een CSV-formaat"

#: admin-templates/tab-import.php:60
msgid "More details on CSV format and import options..."
msgstr "Meer informatie over het CSV-formaat en importmogelijkheden..."

#: admin-templates/tab-import.php:66
msgid "Important:"
msgstr "Belangrijk:"

#: admin-templates/tab-import.php:67
msgid "Omitting Author Email prevents duplicate detection. Re-importing the same file will create duplicate reviews."
msgstr "Als je het e-mailadres van de auteur weglaat, worden dubbele vermeldingen niet gedetecteerd. Als je hetzelfde bestand opnieuw importeert, ontstaan er dubbele beoordelingen."

#: admin-templates/tab-import.php:76
msgid "Upload and Validate"
msgstr "Uploaden en valideren"

#: admin-templates/tab-import.php:84
msgid "Validation Results"
msgstr "Validatieresultaten"

#: admin-templates/tab-import.php:90
msgid "Start Import"
msgstr "Importeren starten"

#: admin-templates/tab-import.php:100
msgid "Import Progress"
msgstr "Voortgang van het importeren"

#: admin-templates/tab-import.php:107
msgid "Preparing import..."
msgstr "Import wordt voorbereid..."

#: admin-templates/tab-import.php:115
msgid "Import Results"
msgstr "Resultaten importeren"

#: admin-templates/tab-import.php:120
msgid "Import Another File"
msgstr "Een ander bestand importeren"

#: admin-templates/tab-settings.php:22
msgid "Settings not available."
msgstr "Deze instellingen zijn niet beschikbaar."

#: admin-templates/tab-settings.php:31
msgid "Import Settings"
msgstr "Instellingen importeren"

#: admin-templates/tab-settings.php:42
msgid "Create User Accounts"
msgstr "Gebruikersaccounts aanmaken"

#: admin-templates/tab-settings.php:47
msgid "Create WordPress user accounts for new reviewers (Customer role)"
msgstr "Maak WordPress-gebruikersaccounts aan voor nieuwe recensenten (rol: Klant)"

#: admin-templates/tab-settings.php:51
msgid "If disabled, reviews will be created as guest comments (user_id = 0)."
msgstr "Als deze optie is uitgeschakeld, worden beoordelingen aangemaakt als gastreacties (user_id = 0)."

#: admin-templates/tab-settings.php:58
msgid "Minimum Review Length"
msgstr "Minimale lengte van de recensie"

#: admin-templates/tab-settings.php:64
msgid "characters"
msgstr "tekens"

#: admin-templates/tab-settings.php:68
msgid "Reviews shorter than this will be rejected during import."
msgstr "Recensies die korter zijn dan dit, worden tijdens het importeren afgewezen."

#: admin-templates/tab-settings.php:75
msgid "Default IP Address"
msgstr "Standaard IP-adres"

#: admin-templates/tab-settings.php:85
msgid "Used when CSV does not provide an author IP address. Leave blank to use server IP."
msgstr "Gebruik dit wanneer CSV geen IP-adres van de auteur verstrekt. Laat dit veld leeg om het IP-adres van de server te gebruiken."

#: admin-templates/tab-settings.php:90
msgid "Auto-Approve Reviews"
msgstr "Recensies automatisch goedkeuren"

#: admin-templates/tab-settings.php:95
msgid "Automatically approve imported reviews"
msgstr "Geïmporteerde beoordelingen automatisch goedkeuren"

#: admin-templates/tab-settings.php:99
msgid "If disabled, imported reviews will require manual moderation."
msgstr "Als deze optie is uitgeschakeld, moeten geïmporteerde beoordelingen handmatig worden gemodereerd."

#: admin-templates/tab-settings.php:104
msgid "Mark as Verified Purchase"
msgstr "Markeren als geverifieerde aankoop"

#: admin-templates/tab-settings.php:109
msgid "Mark imported reviews as verified purchases"
msgstr "Mark heeft beoordelingen geïmporteerd als geverifieerde aankopen"

#: admin-templates/tab-settings.php:113
msgid "Enable this if you have verified that the reviews came from actual purchases (e.g., importing from another WooCommerce store)."
msgstr "Schakel deze optie in als je hebt gecontroleerd of de beoordelingen afkomstig zijn van daadwerkelijke aankopen (bijvoorbeeld bij het importeren vanuit een andere WooCommerce-winkel)."

