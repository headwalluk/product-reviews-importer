#. Plugin Name of the plugin
#: product-reviews-importer.php
#: includes/class-plugin.php:109
msgid "Product Reviews Importer"
msgstr "Importatore di recensioni sui prodotti"

#. Plugin URI of the plugin
#: product-reviews-importer.php
msgid "https://headwall-hosting.com/plugins/product-reviews-importer-for-woocommerce/"
msgstr "https://headwall-hosting.com/plugins/product-reviews-importer-for-woocommerce/"

#. Description of the plugin
#: product-reviews-importer.php
msgid "Import and export WooCommerce product reviews. CSV import with batch processing, and export for Walmart review syndication."
msgstr "Importa ed esporta le recensioni dei prodotti WooCommerce. Importazione CSV con elaborazione in batch ed esportazione per la distribuzione delle recensioni su Walmart."

#. Author of the plugin
#: product-reviews-importer.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: product-reviews-importer.php
msgid "https://headwall-hosting.com/"
msgstr "https://headwall-hosting.com/"

#: views/tab-export.php:23
msgid "Walmart Review Syndication"
msgstr "Distribuzione delle recensioni su Walmart"

#: views/tab-export.php:28
msgid "Export all approved product reviews in the format required for Walmart review syndication. The exported CSV follows Walmart's specification with the following columns:"
msgstr "Esporta tutte le recensioni dei prodotti approvate nel formato richiesto per la distribuzione delle recensioni su Walmart. Il file CSV esportato rispetta le specifiche di Walmart e contiene le seguenti colonne:"

#: includes/class-review-exporter.php:72
msgid "Left blank — fill in with your Walmart Item IDs after export."
msgstr "Lasciare vuoto — inserire i codici articolo Walmart dopo l'esportazione."

#: includes/class-review-exporter.php:73
msgid "Your WooCommerce product SKU."
msgstr "Il codice SKU del tuo prodotto WooCommerce."

#: includes/class-review-exporter.php:74
msgid "Left blank — WooCommerce reviews do not have titles."
msgstr "Lasciato vuoto — Le recensioni di WooCommerce non hanno titoli."

#: includes/class-review-exporter.php:75
msgid "The full review text."
msgstr "Il testo completo della recensione."

#: includes/class-review-exporter.php:76
msgid "Star rating (1–5)."
msgstr "Valutazione a stelle (da 1 a 5)."

#: includes/class-review-exporter.php:82
msgid "The reviewer's name as it appears on your site."
msgstr "Il nome del recensore così come appare sul tuo sito."

#: includes/class-review-exporter.php:83
msgid "Link to the product page on your website."
msgstr "Link alla pagina del prodotto sul tuo sito web."

#: views/tab-export.php:63
msgid "Export Walmart CSV"
msgstr "Esporta in formato CSV per Walmart"

#: views/tab-export.php:68
msgid "No approved reviews to export. Import some reviews first, or check that existing reviews are approved."
msgstr "Non ci sono recensioni approvate da esportare. Importa prima alcune recensioni oppure verifica che quelle esistenti siano state approvate."

#: views/tab-help.php:19
msgid "How to Import Product Reviews"
msgstr "Come importare le recensioni dei prodotti"

#: views/tab-help.php:25
msgid "CSV File Format"
msgstr "Formato file CSV"

#: views/tab-help.php:29
msgid "Your CSV file must include the following columns (all values should be quoted):"
msgstr "Il file CSV deve contenere le seguenti colonne (tutti i valori devono essere racchiusi tra virgolette):"

#: views/tab-help.php:50
msgid "Sample CSV"
msgstr "Esempio di file CSV"

#: views/tab-help.php:60
msgid "Important Notes"
msgstr "Note importanti"

#: views/tab-help.php:65
msgid "Reviews are matched to products using the SKU field"
msgstr "Le recensioni vengono associate ai prodotti tramite il campo SKU"

#: views/tab-help.php:69
msgid "If a product variation SKU is provided, the review will be attached to the parent product"
msgstr "Se viene specificato lo SKU di una variante del prodotto, la recensione verrà associata al prodotto principale"

#: views/tab-help.php:73
msgid "Duplicate reviews (same email + product) will update the existing review"
msgstr "Le recensioni duplicate (stesso indirizzo e-mail + stesso prodotto) aggiorneranno la recensione esistente"

#: views/tab-help.php:77
msgid "Review text supports line breaks and basic formatting"
msgstr "Il testo della recensione supporta le interruzioni di riga e la formattazione di base"

#: views/tab-help.php:81
msgid "Invalid rows will be skipped and reported in the import results"
msgstr "Le righe non valide verranno ignorate e segnalate nei risultati dell'importazione"

#: views/tab-help.php:88
msgid "Troubleshooting"
msgstr "Risoluzione dei problemi"

#: views/tab-help.php:92
msgid "Product not found errors:"
msgstr "Errori relativi a prodotti non trovati:"

#: views/tab-help.php:93
msgid "Verify that the SKU exactly matches a product in your store. SKUs are case-sensitive."
msgstr "Verifica che lo SKU corrisponda esattamente a un prodotto presente nel tuo negozio. Gli SKU distinguono tra maiuscole e minuscole."

#: views/tab-help.php:97
msgid "Invalid email errors:"
msgstr "Errori relativi a indirizzi e-mail non validi:"

#: views/tab-help.php:98
msgid "Ensure email addresses are in valid format (e.g., user@example.com)."
msgstr "Assicurati che gli indirizzi e-mail siano in un formato valido (ad es. user@example.com)."

#: views/tab-help.php:102
msgid "Invalid star rating errors:"
msgstr "Errori relativi alla valutazione a stelle non valida:"

#: views/tab-help.php:103
msgid "Star ratings must be whole numbers from 1 to 5."
msgstr "Le valutazioni a stelle devono essere numeri interi compresi tra 1 e 5."

#: views/tab-help.php:107
msgid "Review text too short:"
msgstr "Il testo della recensione è troppo breve:"

#: views/tab-help.php:108
msgid "Check the minimum review length setting in the Settings tab."
msgstr "Controlla l'impostazione relativa alla lunghezza minima delle recensioni nella scheda Impostazioni."

#: views/tab-help.php:114
msgid "Developer Hooks"
msgstr "Hook per sviluppatori"

#: views/tab-help.php:118
msgid "The following filter hooks are available for developers to extend or customize plugin functionality:"
msgstr "Gli sviluppatori hanno a disposizione i seguenti hook di filtro per estendere o personalizzare le funzionalità del plugin:"

#: views/tab-help.php:123
msgid "Customize CSV field definitions, add custom fields, or modify existing field behavior."
msgstr "Personalizza le definizioni dei campi CSV, aggiungi campi personalizzati o modifica il comportamento dei campi esistenti."

#: views/tab-import.php:20
msgid "Import Reviews from CSV"
msgstr "Importa recensioni da CSV"

#: views/tab-import.php:27
msgid "Step 1: Upload CSV File"
msgstr "Passaggio 1: Carica il file CSV"

#: views/tab-import.php:44
msgid "Select a CSV file containing product reviews. The file must include the following columns:"
msgstr "Seleziona un file CSV contenente le recensioni dei prodotti. Il file deve includere le seguenti colonne:"

#: views/tab-import.php:52
msgid "Sample CSV Format"
msgstr "Esempio di formato CSV"

#: views/tab-import.php:60
msgid "More details on CSV format and import options..."
msgstr "Maggiori dettagli sul formato CSV e sulle opzioni di importazione..."

#: views/tab-import.php:66
msgid "Important:"
msgstr "Importante:"

#: views/tab-import.php:67
msgid "Omitting Author Email prevents duplicate detection. Re-importing the same file will create duplicate reviews."
msgstr "Se non si inserisce l'indirizzo e-mail dell'autore, non sarà possibile individuare i duplicati. Reimportando lo stesso file si creeranno recensioni duplicate."

#: views/tab-import.php:76
msgid "Upload and Validate"
msgstr "Carica e verifica"

#: views/tab-import.php:84
msgid "Validation Results"
msgstr "Risultati della convalida"

#: views/tab-import.php:90
msgid "Start Import"
msgstr "Avvia importazione"

#: views/tab-import.php:100
msgid "Import Progress"
msgstr "Stato dell'importazione"

#: views/tab-import.php:107
msgid "Preparing import..."
msgstr "Preparazione dell'importazione..."

#: views/tab-import.php:115
msgid "Import Results"
msgstr "Importa risultati"

#: views/tab-import.php:120
msgid "Import Another File"
msgstr "Importa un altro file"

#: views/tab-settings.php:22
msgid "Settings not available."
msgstr "Impostazioni non disponibili."

#: views/tab-settings.php:31
msgid "Import Settings"
msgstr "Importa impostazioni"

#: views/tab-settings.php:42
msgid "Create User Accounts"
msgstr "Crea account utente"

#: views/tab-settings.php:47
msgid "Create WordPress user accounts for new reviewers (Customer role)"
msgstr "Crea account utente WordPress per i nuovi revisori (ruolo \"Cliente\")"

#: views/tab-settings.php:51
msgid "If disabled, reviews will be created as guest comments (user_id = 0)."
msgstr "Se questa opzione è disattivata, le recensioni verranno create come commenti degli ospiti (user_id = 0)."

#: views/tab-settings.php:58
msgid "Minimum Review Length"
msgstr "Lunghezza minima della recensione"

#: views/tab-settings.php:68
msgid "Reviews shorter than this will be rejected during import."
msgstr "Le recensioni più brevi di questa saranno rifiutate durante l'importazione."

#: views/tab-settings.php:75
msgid "Default IP Address"
msgstr "Indirizzo IP predefinito"

#: views/tab-settings.php:85
msgid "Used when CSV does not provide an author IP address. Leave blank to use server IP."
msgstr "Da utilizzare quando il file CSV non fornisce l'indirizzo IP dell'autore. Lasciare vuoto per utilizzare l'indirizzo IP del server."

#: views/tab-settings.php:90
msgid "Auto-Approve Reviews"
msgstr "Approvazione automatica delle recensioni"

#: views/tab-settings.php:95
msgid "Automatically approve imported reviews"
msgstr "Approva automaticamente le recensioni importate"

#: views/tab-settings.php:99
msgid "If disabled, imported reviews will require manual moderation."
msgstr "Se disattivata, le recensioni importate dovranno essere moderate manualmente."

#: views/tab-settings.php:104
msgid "Mark as Verified Purchase"
msgstr "Contrassegna come acquisto verificato"

#: views/tab-settings.php:109
msgid "Mark imported reviews as verified purchases"
msgstr "Mark ha importato le recensioni come acquisti verificati"

#: views/tab-settings.php:113
msgid "Enable this if you have verified that the reviews came from actual purchases (e.g., importing from another WooCommerce store)."
msgstr "Attiva questa opzione se hai verificato che le recensioni provengano da acquisti effettivi (ad esempio, in caso di importazione da un altro negozio WooCommerce)."

#: functions-private.php:127
msgid "Product SKU (required)"
msgstr "Codice prodotto (obbligatorio)"

#: functions-private.php:133
msgid "Reviewer name (required)"
msgstr "Nome del recensore (obbligatorio)"

#: functions-private.php:139
msgid "Reviewer email address (optional)"
msgstr "Indirizzo e-mail del recensore (facoltativo)"

#: functions-private.php:145
msgid "Review content (required)"
msgstr "Contenuto della recensione (obbligatorio)"

#: functions-private.php:151
msgid "Star rating 1-5 (required)"
msgstr "Valutazione con stelle da 1 a 5 (obbligatoria)"

#: functions-private.php:157
msgid "IP address (optional)"
msgstr "Indirizzo IP (facoltativo)"

#: functions-private.php:285
msgid "Product Reviews Importer requires WooCommerce to be installed and active."
msgstr "L'estensione \"Product Reviews Importer\" richiede che WooCommerce sia installato e attivo."

